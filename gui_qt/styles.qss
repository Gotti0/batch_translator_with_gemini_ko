/* gui_qt/styles.qss */

/* 
 * DESIGN.md 기반 전역 스타일 시트
 * - Primary: #8E75FF (Gemini Indigo)
 * - Secondary: #C3A1FF (Gemini Violet)
 */

/* 전역 폰트 설정 (필요시) */
* {
    font-family: "Malgun Gothic", "Segoe UI", sans-serif;
}

/* 탭 바 스타일링 */
QTabBar::tab {
    background: transparent;
    padding: 10px 20px;
    border-bottom: 2px solid transparent;
}

QTabBar::tab:selected {
    color: #8E75FF;
    border-bottom: 2px solid #8E75FF;
    font-weight: bold;
}

QTabBar::tab:hover {
    background: rgba(142, 117, 255, 0.1);
}

/* 섹션 그룹박스 (여백 및 구분 강화) */
QGroupBox {
    margin-top: 1.1em;
    font-weight: bold;
    border: 1px solid palette(mid);
    border-radius: 8px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0 5px;
    left: 10px;
}

/* 카드/섹션용 프레임 (ModeCard 등) */
QFrame#SectionCard {
    background-color: palette(alternate-base);
    border-radius: 12px;
    border: 1px solid palette(mid);
}

QFrame#SectionCard:hover {
    border: 1px solid #8E75FF;
    background-color: palette(base);
}

/* ModeCard 선택 상태 (Property Selector) */
QFrame#SectionCard[selected="true"] {
    background-color: rgba(142, 117, 255, 0.15);
    border: 2px solid #8E75FF;
}

/* 모드 카드 내부 텍스트 */
QLabel#ModeCardTitle {
    font-weight: bold;
}

QLabel#ModeCardDesc {
    /* 화이트 테마에서 가독성을 위해 너무 연하지 않은 색상 사용 */
    color: palette(text);
    opacity: 0.8;
}

/* 버튼 스타일링 */
QPushButton#PrimaryButton {
    background-color: #8E75FF;
    border: none;
    font-weight: bold;
    color: #FFFFFF;
}

QPushButton#PrimaryButton:hover {
    background-color: #A38FFF;
}

QPushButton#PrimaryButton:pressed {
    background-color: #7A5CFF;
}

/* 프로그레스 바 */
QProgressBar {
    border: 1px solid palette(mid);
    border-radius: 6px;
    text-align: center;
}

QProgressBar::chunk {
    background-color: qlineargradient(spread:pad, x1:0, y1:0, x2:1, y2:0, stop:0 #8E75FF, stop:1 #C3A1FF);
    border-radius: 6px;
}

/* 스크롤바 커스텀 (테마 적응형) */
QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0px;
}

QScrollBar::handle:vertical {
    background: palette(mid);
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background: #8E75FF;
}

/* 타임라인 아이템 애니메이션 느낌 부여 */
QWidget#ActivityItem {
    border-left: 3px solid transparent;
}

QWidget#ActivityItem:hover {
    background-color: rgba(142, 117, 255, 0.08);
    border-left: 3px solid #8E75FF;
}

QLabel#ActivityTime {
    color: palette(placeholder-text);
}

QLabel#ActivityMessage {
    color: palette(text);
}

QLabel#ActivityHeader {
    color: palette(text);
}
